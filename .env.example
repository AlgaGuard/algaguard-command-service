NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://algaguard:change-me@localhost:5432/algaguard
LOG_LEVEL=info
CONTRACTS_DIR=../algaguard-contracts
MQTT_URL=mqtts://localhost:8884
MQTT_CLIENT_ID=algaguard-command-service
MQTT_CA_PATH=.local/pki/device-ca/ca.crt
MQTT_CERTIFICATE_PATH=.local/pki/services/algaguard-command-service/tls.crt
MQTT_PRIVATE_KEY_PATH=.local/pki/services/algaguard-command-service/tls.key
MQTT_SERVER_NAME=emqx
MQTT_QOS1_INFLIGHT=32
MQTT_KEEPALIVE_SECONDS=60
MQTT_SESSION_EXPIRY_SECONDS=3600
MQTT_RECONNECT_DELAY_MS=2000
KEYCLOAK_ISSUER=http://localhost:8080/realms/algaguard
KEYCLOAK_AUDIENCE=algaguard-api
SERVICE_CLIENT_ID=algaguard-command-service
SERVICE_CLIENT_SECRET=replace-with-secret
ACCESS_SERVICE_URL=http://localhost:3001

